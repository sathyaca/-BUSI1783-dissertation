# ============================================================
# CELL 6 — CHI-SQUARE TEST WITH CRAMÉR'S V
# ============================================================
print("=== CHI-SQUARE TEST WITH EFFECT SIZE ===")

contingency = pd.crosstab(df['Category'], df['Vader_Label'])
print("Contingency Table:")
print(contingency)

chi2, p, dof, expected = chi2_contingency(contingency)

def cramers_v(contingency_table):
    chi2_val = chi2_contingency(contingency_table)[0]
    n = contingency_table.sum().sum()
    r, k = contingency_table.shape
    return np.sqrt(chi2_val / (n * (min(r, k) - 1)))

v = cramers_v(contingency)

if v < 0.1:
    effect = "negligible"
elif v < 0.3:
    effect = "small"
elif v < 0.5:
    effect = "moderate"
else:
    effect = "large"

print(f"\nChi2 Statistic:     {chi2:.4f}")
print(f"P-value:            {p:.6f}")
print(f"Degrees of Freedom: {dof}")
print(f"Cramér's V:         {v:.4f} ({effect} effect)")

if p < 0.05:
    print(f"\n✅ SIGNIFICANT (p < 0.05) — {effect} effect size")
    print("Sentiment differences between categories are NOT due to chance")
else:
    print(f"\n❌ NOT SIGNIFICANT (p > 0.05)")

# ============================================================
# CELL 7 — BERTOPIC (SINGLE FIT — DO NOT RERUN)
# ============================================================
print("Running BERTopic — single fit only...")

# Fixed UMAP — random_state ensures reproducibility
umap_model = UMAP(
    n_neighbors=15,
    n_components=5,
    min_dist=0.0,
    metric='cosine',
    random_state=42
)

# HDBSCAN with min_cluster_size=20 as supervisor advised
hdbscan_model = HDBSCAN(
    min_cluster_size=20,
    min_samples=10,
    metric='euclidean',
    cluster_selection_method='eom',
    prediction_data=True
)

embedding_model = SentenceTransformer('all-MiniLM-L6-v2')

topic_model = BERTopic(
    embedding_model=embedding_model,
    umap_model=umap_model,
    hdbscan_model=hdbscan_model,
    min_topic_size=20,
    nr_topics='auto',
    calculate_probabilities=False,
    verbose=True
)

# FIT ONCE — never refit
docs = df['Clean_Text'].astype(str).tolist()
topics, probs = topic_model.fit_transform(docs)
df['Topic'] = topics

# Report results
topic_info = topic_model.get_topic_info()
total_topics = len(topic_info[topic_info['Topic'] != -1])
outlier_count = len(df[df['Topic'] == -1])
outlier_pct = round(outlier_count / len(df) * 100, 1)

print(f"\n=== BERTOPIC RESULTS ===")
print(f"Total topics found (after reduction): {total_topics}")
print(f"Outlier documents (Topic -1): {outlier_count} ({outlier_pct}%)")
print(f"\nFull Topic Info:")
print(topic_info)

print("\nTop keywords and representative review per topic:")
for row in topic_info.itertuples():
    if row.Topic == -1:
        continue
    words = topic_model.get_topic(row.Topic)
    keywords = [w[0] for w in words[:8]]
    rep_docs = topic_model.get_representative_docs(row.Topic)
    print(f"\nTopic {row.Topic} ({row.Count} docs)")
    print(f"  Keywords:        {', '.join(keywords)}")
    print(f"  Representative:  {rep_docs[0][:120]}")

